{
  "name": "readaside-extension",
  "version": "0.11.1",
  "description": "A privacy-conscious Chrome side panel for reading webpages with your own DeepSeek API key.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "chrome-extension",
    "side-panel",
    "web-reading",
    "deepseek",
    "byok"
  ],
  "scripts": {
    "build": "esbuild lib/markdown.mjs --bundle --format=esm --minify --outfile=dist/markdown-renderer.mjs --asset-names=fonts/[name]-[hash] --loader:.woff2=file --loader:.woff=file --loader:.ttf=file",
    "check": "node scripts/check.mjs",
    "evaluate:context": "node scripts/evaluate-context.mjs",
    "evaluate:context:compare": "node scripts/evaluate-context.mjs --compare=docs/evaluation/snapshots/0.11.0.json",
    "evaluate:context:gate": "node scripts/evaluate-context.mjs --enforce",
    "evaluate:citations": "node scripts/evaluate-citations.mjs",
    "evaluate:evidence": "node scripts/evaluate-evidence.mjs",
    "test": "node --test",
    "verify": "npm run check && npm test && npm run evaluate:context:compare && npm run evaluate:citations && npm run evaluate:evidence && node --check background.mjs && node --check sidepanel.mjs",
    "package": "npm run build && npm run verify && node scripts/package.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "katex": "0.18.0",
    "marked": "18.0.7",
    "marked-footnote": "1.4.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
